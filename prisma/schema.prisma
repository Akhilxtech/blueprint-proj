generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuizRunStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  ENDED
}

enum TeamQuizStatus {
  ACTIVE
  ELIMINATED
}

model Team {
  id              String         @id @default(cuid())
  name            String         @unique
  participants    Participant[]
  rulesAcceptedAt DateTime?
  lastSeenAt      DateTime?
  quizStatus      TeamQuizStatus @default(ACTIVE)
  warningCount    Int            @default(0)
  eliminatedAt    DateTime?
  isFinalist      Boolean        @default(false)
  quizRoster      QuizRoster?
  responses       Response[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

violationEvents ViolationEvent[]
  @@index([lastSeenAt])
  @@map("teams")
}

model Participant {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?  @unique
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usn       String?
  phone     String?
  semester  String?
  branch    String?

  team Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("participants")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  participant   Participant?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

model Question {
  id           String            @id @default(cuid())
  externalId   String?           @unique
  text         String            @db.Text
  codeLanguage String?
  code         String?           @db.Text
  type         String            @default("THEORY")
  timeSeconds  Int?
  marks        Int               @default(1)
  position     Int
  included     Boolean           @default(true)
  options      QuestionOption[]
  runQuestions QuizRunQuestion[]
  responses    Response[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([included, position])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  content    String   @db.Text
  isCode     Boolean  @default(false)
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([questionId])
  @@map("question_options")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model QuizRun {
  id        String        @id
  status    QuizRunStatus @default(NOT_STARTED)
  startedAt DateTime?
  pausedAt  DateTime?
  pausedMs  Int           @default(0)
  skipMs    Int           @default(0)
  endedAt   DateTime?

  questions QuizRunQuestion[]

  @@map("quiz_runs")
}

model QuizRunQuestion {
  id         String @id @default(cuid())
  runId      String
  position   Int
  questionId String
  durationMs Int
  gapMs      Int

  run      QuizRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([runId, position])
  @@unique([runId, questionId])
  @@index([questionId])
  @@map("quiz_run_questions")
}

model QuizRoster {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("quiz_roster")
}

model Response {
  id         String   @id @default(cuid())
  teamId     String
  questionId String
  optionId   String
  answeredAt DateTime @default(now())
  responseMs Int

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([teamId, questionId])
  @@index([questionId])
  @@map("responses")
}



model ViolationEvent {
  id            String   @id @default(cuid())
  teamId        String
  clientEventId String   @unique
  startedAt     DateTime
  durationMs    Int
  createdAt     DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("tab_switch_violations")
}