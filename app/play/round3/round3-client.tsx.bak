
"use client";

import { useCallback, useEffect, useMemo, useState } from "react";

type StatementStatus = "Available" | "Full" | "Unavailable" | "Selected";

type Hint = {
  id: string;
  order: number;
  title: string;
  content: string;
};

type Statement = {
  id: string;
  title: string;
  domain: string;
  difficulty: string;
  shortDescription: string;
  maxTeams: number | null;
  selectedCount: number;
  status: StatementStatus;
  description?: string;
  constraints?: string;
  deliverables?: string;
  hints?: Hint[];
};

type Round3State = {
  serverNow: string;
  isFinalist: boolean;
  selectionWindow: {
    isOpen: boolean;
    durationMinutes: number;
    deadline: string | null;
  };
  submissionWindow: {
    isOpen: boolean;
    durationMinutes: number;
    deadline: string | null;
  };
  selectedStatementId: string | null;
  selectedAt: string | null;
  assignedByAdmin: boolean;
  statements: Statement[];
};


type Deliverable = {
  index: number;
  text: string;
  completed: boolean;
};

type Round3ClientProps = {
  participantName: string;
  teamName: string;
};

function formatDate(value: string | null) {
  if (!value) return "Not available";

  return new Date(value).toLocaleString("en-IN", {
    dateStyle: "medium",
    timeStyle: "short",
  });
}

function remainingTime(deadline: string | null, serverNow: string) {
  if (!deadline) return null;

  const seconds = Math.max(
    0,
    Math.floor(
      (new Date(deadline).getTime() - new Date(serverNow).getTime()) / 1000,
    ),
  );

  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const remainder = seconds % 60;

  return `${String(hours).padStart(2, "0")}:${String(minutes).padStart(2, "0")}:${String(remainder).padStart(2, "0")}`;
}

export default function Round3Client({
  participantName,
  teamName,
}: Round3ClientProps) {
  const [data, setData] = useState<Round3State | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [domain, setDomain] = useState("All");
  const [details, setDetails] = useState<Statement | null>(null);
  const [confirmSelection, setConfirmSelection] =
    useState<Statement | null>(null);



    const [deploymentUrl, setDeploymentUrl] = useState("");
const [savedDeploymentUrl, setSavedDeploymentUrl] = useState("");
const [submissionDeadline, setSubmissionDeadline] = useState<string | null>(null);
const [submissionOpen, setSubmissionOpen] = useState(false);
const [savingDeployment, setSavingDeployment] = useState(false);
const [deploymentMessage, setDeploymentMessage] = useState("");


const [deliverables, setDeliverables] = useState<Deliverable[]>([]);
const [loadingDeliverables, setLoadingDeliverables] = useState(false);
const [updatingDeliverable, setUpdatingDeliverable] = useState<number | null>(null);

  const [selecting, setSelecting] = useState(false);
  const [now, setNow] = useState(new Date().toISOString());

  const loadState = useCallback(async (showLoading = false) => {
    if (showLoading) setLoading(true);

    try {
      const response = await fetch("/api/round3/state", {
        cache: "no-store",
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? "Could not load problem statements.");
      }

      setData(result as Round3State);
      setError("");
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Could not load Round 3.",
      );
    } finally {
      setLoading(false);
    }
  }, []);

  const loadSubmission = useCallback(async () => {
  try {
    const response = await fetch("/api/round3/submission", {
      cache: "no-store",
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.error ?? "Could not load deployment submission.");
    }

    const savedUrl = result.submission?.url ?? "";

    setSavedDeploymentUrl(savedUrl);
    setDeploymentUrl((current) => current || savedUrl);
    setSubmissionOpen(
      result.window.isOpen &&
        !!result.window.deadline &&
        Date.parse(result.window.deadline) > Date.now(),
    );
    setSubmissionDeadline(result.window.deadline ?? null);
  } catch (err) {
    setDeploymentMessage(
      err instanceof Error ? err.message : "Could not load deployment submission.",
    );
  }
}, []);


const loadDeliverables = useCallback(async () => {
  try {
    setLoadingDeliverables(true);

    const response = await fetch("/api/round3/deliverables", {
      cache: "no-store",
    });
    const result = await response.json();

    if (!response.ok) {
      if (response.status === 409) {
        setDeliverables([]);
        return;
      }

      throw new Error(result.error ?? "Could not load deliverables.");
    }

    setDeliverables(result.deliverables ?? []);
  } catch (err) {
    setError(
      err instanceof Error ? err.message : "Could not load deliverables.",
    );
  } finally {
    setLoadingDeliverables(false);
  }
}, []);


async function toggleDeliverable(index: number, completed: boolean) {
  if (updatingDeliverable !== null) return;

  const previous = deliverables;

  setDeliverables((items) =>
    items.map((item) =>
      item.index === index ? { ...item, completed } : item,
    ),
  );
  setUpdatingDeliverable(index);

  try {
    const response = await fetch("/api/round3/deliverables", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ index, completed }),
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.error ?? "Could not update deliverable.");
    }
  } catch (err) {
    setDeliverables(previous);
    setError(
      err instanceof Error ? err.message : "Could not update deliverable.",
    );
  } finally {
    setUpdatingDeliverable(null);
  }
}

async function saveDeployment() {
  if (savingDeployment) return;

  setSavingDeployment(true);
  setDeploymentMessage("");

  try {
    const response = await fetch("/api/round3/submission", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ url: deploymentUrl }),
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.error ?? "Could not save deployment URL.");
    }

    setSavedDeploymentUrl(result.submission.url);
    setDeploymentUrl(result.submission.url);
    setDeploymentMessage("Deployment URL saved successfully.");
  } catch (err) {
    setDeploymentMessage(
      err instanceof Error ? err.message : "Could not save deployment URL.",
    );
  } finally {
    setSavingDeployment(false);
  }
}

useEffect(() => {
  const initialLoad = window.setTimeout(() => {
    void loadState();
  }, 0);

  const poll = window.setInterval(() => {
    void loadState();
    void loadSubmission();
    void loadDeliverables();
  }, 10000);

  const clock = window.setInterval(() => {
    setNow(new Date().toISOString());
  }, 1000);

  return () => {
    window.clearTimeout(initialLoad);
    window.clearInterval(poll);
    window.clearInterval(clock);
  };
}, [loadState,loadSubmission,loadDeliverables]);

  const domains = useMemo(
    () => [
      "All",
      ...Array.from(new Set((data?.statements ?? []).map((s) => s.domain)))
        .sort((a, b) => a.localeCompare(b)),
    ],
    [data?.statements],
  );

  const filteredStatements = useMemo(() => {
    const query = search.trim().toLowerCase();

    return (data?.statements ?? []).filter((statement) => {
      const matchesDomain = domain === "All" || statement.domain === domain;
      const matchesSearch =
        !query ||
        statement.title.toLowerCase().includes(query) ||
        statement.domain.toLowerCase().includes(query) ||
        statement.shortDescription.toLowerCase().includes(query);

      return matchesDomain && matchesSearch;
    });
  }, [data?.statements, search, domain]);

  async function selectStatement() {
    if (!confirmSelection || selecting) return;

    setSelecting(true);
    setError("");

    try {
      const response = await fetch("/api/round3/select", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ statementId: confirmSelection.id }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? "Could not select this problem.");
      }

      setConfirmSelection(null);
      setDetails(null);
      await loadState();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Could not select this problem.",
      );
      await loadState();
    } finally {
      setSelecting(false);
    }
  }

  const selectedStatement = data?.statements.find(
    (statement) => statement.id === data.selectedStatementId,
  );

  const timeLeft = remainingTime(data?.selectionWindow.deadline ?? null, now);

  return (
    <main className="min-h-screen bg-zinc-950 px-4 py-8 text-white sm:px-6 sm:py-12">
      <div className="mx-auto max-w-6xl">
        <header className="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
          <div>
            <p className="text-sm font-medium text-violet-400">
              Blueprint to Live
            </p>
            <h1 className="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
              Round 3: Final Build-Off
            </h1>
            <p className="mt-2 text-zinc-400">
              Welcome, {participantName}. Team:{" "}
              <span className="font-medium text-white">{teamName}</span>
            </p>
          </div>

          <a
            href="/play"
            className="w-fit rounded-lg border border-white/10 px-4 py-2 text-sm text-zinc-300 transition hover:bg-white/5"
          >
            Back to dashboard
          </a>
        </header>

        {error && (
          <div
            role="alert"
            className="mt-6 flex items-start justify-between gap-4 rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300"
          >
            <p>{error}</p>
            <button
              type="button"
              onClick={() => setError("")}
              className="shrink-0 text-red-200 hover:text-white"
              aria-label="Dismiss error"
            >
              ✕
            </button>
          </div>
        )}

        {loading && !data ? (
          <section className="mt-8 rounded-2xl border border-white/10 bg-zinc-900 p-8">
            <p className="animate-pulse text-zinc-400">
              Loading problem statements...
            </p>
          </section>
        ) : data && !data.isFinalist ? (
          <section className="mt-8 rounded-2xl border border-white/10 bg-zinc-900 p-8">
            <h2 className="text-2xl font-semibold">
              Thank you for participating!
            </h2>
            <p className="mt-3 text-zinc-400">
              Round 3 is available only to finalist teams.
            </p>
          </section>
        ) : data ? (
          <>
            <section className="mt-8 grid gap-4 sm:grid-cols-3">
              <div className="rounded-2xl border border-white/10 bg-zinc-900 p-5">
                <p className="text-sm text-zinc-400">Your selection</p>
                <p className="mt-2 text-lg font-semibold">
                  {selectedStatement?.title ?? "Not selected"}
                </p>
                <p className="mt-1 text-xs text-zinc-500">
                  {data.assignedByAdmin
                    ? "Assigned by the event admin"
                    : data.selectedAt
                      ? `Selected ${formatDate(data.selectedAt)}`
                      : "Choose one problem statement"}
                </p>
              </div>


<section className="mt-6 rounded-2xl border border-white/10 bg-zinc-900 p-6">
  <div className="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
    <div>
      <h2 className="text-xl font-bold">Deployment submission</h2>
      <p className="mt-2 text-sm text-zinc-400">
        Submit your team&apos;s deployed static website URL from EC2.
        You can update it while submissions are open.
      </p>
    </div>

    <span
      className={`w-fit rounded-full px-3 py-1 text-xs font-medium ${
        submissionOpen
          ? "bg-emerald-500/10 text-emerald-400"
          : "bg-zinc-800 text-zinc-400"
      }`}
    >
      {submissionOpen ? "Submissions open" : "Submissions closed"}
    </span>
  </div>

  <div className="mt-5 rounded-xl border border-white/10 bg-zinc-950 p-4">
    <p className="text-sm text-zinc-400">Submission deadline</p>
    <p className="mt-1 font-semibold">
      {submissionDeadline
        ? formatDate(submissionDeadline)
        : "Not announced"}
    </p>
    <p className="mt-2 text-sm text-zinc-500">
      Time remaining: {remainingTime(submissionDeadline, now) ?? "Not available"}
    </p>
  </div>

  <form
    className="mt-5 space-y-3"
    onSubmit={(event) => {
      event.preventDefault();
      void saveDeployment();
    }}
  >
    <label htmlFor="deployment-url" className="block text-sm font-medium">
      EC2 website URL
    </label>

    <input
      id="deployment-url"
      type="url"
      required
      maxLength={2048}
      value={deploymentUrl}
      onChange={(event) => setDeploymentUrl(event.target.value)}
      placeholder="http://your-ec2-public-ip or https://your-domain"
      disabled={!submissionOpen || !data.selectedStatementId || savingDeployment}
      className="w-full rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-sm outline-none placeholder:text-zinc-600 focus:border-violet-500 disabled:cursor-not-allowed disabled:opacity-50"
    />

    <p className="text-xs text-zinc-500">
      Your team must select a problem statement before submitting.
    </p>

    <button
      type="submit"
      disabled={
        !submissionOpen ||
        !data.selectedStatementId ||
        savingDeployment ||
        !deploymentUrl.trim()
      }
      className="rounded-lg bg-violet-600 px-5 py-3 text-sm font-semibold hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-50"
    >
      {savingDeployment
        ? "Saving..."
        : savedDeploymentUrl
          ? "Update deployment URL"
          : "Submit deployment URL"}
    </button>
  </form>

  {savedDeploymentUrl && (
    <div className="mt-5 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4">
      <p className="text-sm font-medium text-emerald-400">
        Saved deployment URL
      </p>
      <a
        href={savedDeploymentUrl}
        target="_blank"
        rel="noopener noreferrer"
        className="mt-2 block break-all text-sm text-violet-300 underline underline-offset-4"
      >
        {savedDeploymentUrl}
      </a>
    </div>
  )}

  {deploymentMessage && (
    <p role="status" className="mt-4 text-sm text-zinc-300">
      {deploymentMessage}
    </p>
  )}
</section>


              <div className="rounded-2xl border border-white/10 bg-zinc-900 p-5">
                <p className="text-sm text-zinc-400">Selection window</p>
                <p className="mt-2 text-lg font-semibold">
                  {data.selectionWindow.isOpen && timeLeft !== "00:00:00"
                    ? "Open"
                    : "Closed"}
                </p>
                <p className="mt-1 text-xs text-zinc-500">
                  {data.selectionWindow.isOpen
                    ? `Time remaining: ${timeLeft ?? "Unknown"}`
                    : "Wait for the event admin to open selection"}
                </p>
              </div>

              <div className="rounded-2xl border border-white/10 bg-zinc-900 p-5">
                <p className="text-sm text-zinc-400">Available statements</p>
                <p className="mt-2 text-2xl font-bold">
                  {data.statements.filter((s) => s.status === "Available").length}
                </p>
                <p className="mt-1 text-xs text-zinc-500">
                  State refreshes automatically
                </p>
              </div>
            </section>

            {selectedStatement && (
              <section className="mt-6 rounded-2xl border border-violet-500/30 bg-violet-500/5 p-5">
                <p className="text-sm font-medium text-violet-300">
                  Your team&apos;s problem statement
                </p>
                <h2 className="mt-2 text-xl font-semibold">
                  {selectedStatement.title}
                </h2>
                <button
                  type="button"
                  onClick={() => setDetails(selectedStatement)}
                  className="mt-4 rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium hover:bg-violet-500"
                >
                  View full statement
                </button>
              </section>

              
            )}


{data.selectedStatementId && (
  <section className="mt-6 rounded-2xl border border-white/10 bg-zinc-900 p-6">
    <div className="flex items-center justify-between gap-3">
      <div>
        <h2 className="text-xl font-bold">Deliverables checklist</h2>
        <p className="mt-1 text-sm text-zinc-400">
          Progress is shared with your teammates.
        </p>
      </div>
      <span className="text-sm text-zinc-400">
        {deliverables.filter((item) => item.completed).length}/
        {deliverables.length}
      </span>
    </div>

    {loadingDeliverables && deliverables.length === 0 ? (
      <p className="mt-5 text-sm text-zinc-400">
        Loading deliverables...
      </p>
    ) : deliverables.length === 0 ? (
      <p className="mt-5 text-sm text-zinc-400">
        No deliverables have been configured for this statement.
      </p>
    ) : (
      <ul className="mt-5 space-y-3">
        {deliverables.map((item) => (
          <li key={item.index}>
            <label className="flex cursor-pointer items-start gap-3 rounded-xl border border-white/10 p-4 transition hover:bg-white/[0.03]">
              <input
                type="checkbox"
                checked={item.completed}
                disabled={updatingDeliverable !== null}
                onChange={(event) =>
                  void toggleDeliverable(item.index, event.target.checked)
                }
                className="mt-1 size-4 accent-violet-500"
              />
              <span
                className={`text-sm leading-6 ${
                  item.completed
                    ? "text-zinc-500 line-through"
                    : "text-zinc-200"
                }`}
              >
                {item.text}
              </span>
              {updatingDeliverable === item.index && (
                <span className="ml-auto text-xs text-zinc-500">
                  Saving...
                </span>
              )}
            </label>
          </li>
        ))}
      </ul>
    )}
  </section>
)}


{selectedStatement && (
  <section className="mt-6 rounded-2xl border border-white/10 bg-zinc-900 p-6">
    <div>
      <h2 className="text-xl font-bold">Problem-solving hints</h2>
      <p className="mt-1 text-sm text-zinc-400">
        Use these hints when your team needs guidance.
      </p>
    </div>

    {selectedStatement.hints && selectedStatement.hints.length > 0 ? (
      <div className="mt-5 space-y-3">
        {selectedStatement.hints
          .slice()
          .sort((a, b) => a.order - b.order)
          .map((hint) => (
            <details
              key={hint.id}
              className="group rounded-xl border border-white/10 bg-zinc-950"
            >
              <summary className="flex cursor-pointer list-none items-center justify-between gap-3 p-4 font-medium">
                <span>
                  Hint {hint.order}: {hint.title}
                </span>
                <span className="text-zinc-500 transition group-open:rotate-180">
                  ↓
                </span>
              </summary>
              <div className="border-t border-white/10 px-4 py-4 text-sm leading-6 text-zinc-300">
                {hint.content}
              </div>
            </details>
          ))}
      </div>
    ) : (
      <p className="mt-5 text-sm text-zinc-400">
        No hints have been configured for this statement yet.
      </p>
    )}
  </section>
)}



            <section className="mt-10">
              <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                <div>
                  <h2 className="text-2xl font-bold">Problem statements</h2>
                  <p className="mt-1 text-sm text-zinc-400">
                    {data.selectedStatementId
                      ? "Your team's choice is locked. You can review the other statements."
                      : "Explore the available challenges and choose carefully."}
                  </p>
                </div>
                <p className="text-sm text-zinc-500">
                  {filteredStatements.length} of {data.statements.length} shown
                </p>
              </div>

              <div className="mt-5 grid gap-3 sm:grid-cols-[1fr_220px]">
                <input
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                  placeholder="Search by title, domain, or description..."
                  className="w-full rounded-xl border border-white/10 bg-zinc-900 px-4 py-3 text-sm outline-none placeholder:text-zinc-500 focus:border-violet-500"
                  aria-label="Search problem statements"
                />
                <select
                  value={domain}
                  onChange={(event) => setDomain(event.target.value)}
                  className="rounded-xl border border-white/10 bg-zinc-900 px-4 py-3 text-sm outline-none focus:border-violet-500"
                  aria-label="Filter by domain"
                >
                  {domains.map((item) => (
                    <option key={item} value={item}>
                      {item === "All" ? "All domains" : item}
                    </option>
                  ))}
                </select>
              </div>

              <div className="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {filteredStatements.map((statement) => {
                  const isSelected =
                    statement.id === data.selectedStatementId;
                  const canSelect =
                    !data.selectedStatementId &&
                    data.selectionWindow.isOpen &&
                    timeLeft !== "00:00:00" &&
                    statement.status === "Available";

                  return (
                    <article
                      key={statement.id}
                      className={`flex flex-col rounded-2xl border bg-zinc-900 p-5 transition ${
                        isSelected
                          ? "border-violet-500/60 ring-1 ring-violet-500/20"
                          : "border-white/10 hover:border-white/20"
                      }`}
                    >
                      <div className="flex flex-wrap items-center gap-2">
                        <span className="rounded-full bg-white/5 px-3 py-1 text-xs text-zinc-300">
                          {statement.domain}
                        </span>
                        <span className="rounded-full bg-white/5 px-3 py-1 text-xs text-zinc-400">
                          {statement.difficulty}
                        </span>
                      </div>

                      <h3 className="mt-4 text-lg font-semibold leading-snug">
                        {statement.title}
                      </h3>
                      <p className="mt-3 flex-1 text-sm leading-6 text-zinc-400">
                        {statement.shortDescription}
                      </p>

                      <div className="mt-5 flex items-center justify-between gap-3 border-t border-white/10 pt-4">
                        <div>
                          <p
                            className={`text-sm font-medium ${
                              isSelected
                                ? "text-violet-300"
                                : statement.status === "Available"
                                  ? "text-emerald-400"
                                  : "text-zinc-400"
                            }`}
                          >
                            {isSelected ? "Your selection" : statement.status}
                          </p>
                          <p className="mt-1 text-xs text-zinc-500">
                            {statement.selectedCount} selected
                            {statement.maxTeams !== null
                              ? ` / ${statement.maxTeams} teams`
                              : " / no limit"}
                          </p>
                        </div>

                        <button
                          type="button"
                          onClick={() => setDetails(statement)}
                          className="rounded-lg border border-white/10 px-3 py-2 text-sm hover:bg-white/5"
                        >
                          Details
                        </button>
                      </div>

                      {canSelect && (
                        <button
                          type="button"
                          onClick={() => setConfirmSelection(statement)}
                          className="mt-4 w-full rounded-lg bg-violet-600 px-4 py-3 text-sm font-semibold transition hover:bg-violet-500"
                        >
                          Select this problem
                        </button>
                      )}
                    </article>
                  );
                })}
              </div>

              {filteredStatements.length === 0 && (
                <div className="mt-6 rounded-2xl border border-dashed border-white/10 p-10 text-center">
                  <p className="font-medium">No matching statements</p>
                  <p className="mt-2 text-sm text-zinc-400">
                    Try another search term or domain.
                  </p>
                </div>
              )}
            </section>
          </>
        ) : (
          <section className="mt-8 rounded-2xl border border-white/10 bg-zinc-900 p-8">
            <p className="text-zinc-300">
              Round 3 could not be loaded.
            </p>
            <button
              type="button"
              onClick={() => void loadState(true)}
              className="mt-4 rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium hover:bg-violet-500"
            >
              Retry
            </button>
          </section>
        )}
      </div>

      {details && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4"
          onClick={() => setDetails(null)}
        >
          <section
            role="dialog"
            aria-modal="true"
            aria-labelledby="statement-dialog-title"
            className="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl border border-white/10 bg-zinc-900 p-6 sm:p-8"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="flex items-start justify-between gap-4">
              <div>
                <p className="text-sm text-violet-400">{details.domain}</p>
                <h2
                  id="statement-dialog-title"
                  className="mt-2 text-2xl font-bold"
                >
                  {details.title}
                </h2>
              </div>
              <button
                type="button"
                onClick={() => setDetails(null)}
                className="rounded-lg border border-white/10 px-3 py-2 text-sm hover:bg-white/5"
                aria-label="Close statement details"
              >
                ✕
              </button>
            </div>

            {details.description ? (
              <div className="mt-6 whitespace-pre-wrap text-sm leading-7 text-zinc-300">
                {details.description}
              </div>
            ) : (
            <div className="mt-6">
  <h3 className="font-semibold">Problem description</h3>
  <div className="mt-2 whitespace-pre-wrap text-sm leading-7 text-zinc-300">
    {details.description || "No description provided yet."}
  </div>
</div>
            )}

            {details.constraints && (
              <div className="mt-6">
                <h3 className="font-semibold">Constraints</h3>
                <p className="mt-2 whitespace-pre-wrap text-sm leading-6 text-zinc-400">
                  {details.constraints}
                </p>
              </div>
            )}

            {details.deliverables && (
              <div className="mt-6">
                <h3 className="font-semibold">Deliverables</h3>
                <ul className="mt-2 list-inside list-disc space-y-2 text-sm leading-6 text-zinc-400">
                  {details.deliverables
                    .split("\n")
                    .filter(Boolean)
                    .map((item, index) => (
                      <li key={`${index}-${item}`}>{item}</li>
                    ))}
                </ul>
              </div>
            )}

            {details.hints && details.hints.length > 0 && (
              <div className="mt-6">
                <h3 className="font-semibold">Hints</h3>
                <div className="mt-3 space-y-3">
                  {details.hints.map((hint) => (
                    <div
                      key={hint.id}
                      className="rounded-xl border border-white/10 bg-zinc-950 p-4"
                    >
                      <p className="font-medium">{hint.title}</p>
                      <p className="mt-2 whitespace-pre-wrap text-sm leading-6 text-zinc-400">
                        {hint.content}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {!data?.selectedStatementId &&
              data?.selectionWindow.isOpen &&
              details.status === "Available" && (
                <button
                  type="button"
                  onClick={() => setConfirmSelection(details)}
                  className="mt-8 w-full rounded-lg bg-violet-600 px-4 py-3 font-semibold hover:bg-violet-500"
                >
                  Select this problem
                </button>
              )}
          </section>
        </div>
      )}

      {confirmSelection && (
        <div
          className="fixed inset-0 z-[60] flex items-center justify-center bg-black/80 p-4"
          onClick={() => {
            if (!selecting) setConfirmSelection(null);
          }}
        >
          <section
            role="dialog"
            aria-modal="true"
            aria-labelledby="confirm-title"
            className="w-full max-w-md rounded-2xl border border-white/10 bg-zinc-900 p-6"
            onClick={(event) => event.stopPropagation()}
          >
            <h2 id="confirm-title" className="text-xl font-bold">
              Confirm your selection
            </h2>
            <p className="mt-3 text-sm leading-6 text-zinc-400">
              Your team is about to select{" "}
              <span className="font-semibold text-white">
                {confirmSelection.title}
              </span>
              . This choice cannot be changed by your team after confirmation.
            </p>
            <p className="mt-3 text-sm text-amber-300">
              Make sure your team agrees before continuing.
            </p>

            <div className="mt-6 grid grid-cols-2 gap-3">
              <button
                type="button"
                disabled={selecting}
                onClick={() => setConfirmSelection(null)}
                className="rounded-lg border border-white/10 px-4 py-3 text-sm hover:bg-white/5 disabled:opacity-50"
              >
                Cancel
              </button>
              <button
                type="button"
                disabled={selecting}
                onClick={() => void selectStatement()}
                className="rounded-lg bg-violet-600 px-4 py-3 text-sm font-semibold hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-50"
              >
                {selecting ? "Selecting..." : "Confirm choice"}
              </button>
            </div>
          </section>
        </div>
      )}
    </main>
  );
}
